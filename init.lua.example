-- Hammerspoon entry point.
require("hs.ipc")          -- enables the `hs` command-line tool
hs.autoLaunch(true)        -- login item; install.sh also adds a launchd agent that relaunches Hammerspoon if it quits

typeless = require("typeless_paywall_closer")
typeless.start()

-- Control+Option+Command+T: dump the Typeless accessibility tree to the Hammerspoon console.
hs.hotkey.bind({ "ctrl", "alt", "cmd" }, "T", function()
  hs.openConsole()
  typeless.dump()
end)
